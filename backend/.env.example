MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
CORS_ORIGINS=https://nayamo-2.onrender.com,https://nayamo-3.onrender.com
PORT=5000
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

CLIENT_URL=https://nayamo.in
EMAIL_PROVIDER=smtp
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=your_smtp_user@example.com
SMTP_TIMEOUT_MS=60000

# Shiprocket (backend only)
SHIPROCKET_EMAIL=your_shiprocket_api_user@example.com
SHIPROCKET_PASSWORD=your_shiprocket_api_password
SHIPROCKET_PICKUP_LOCATION=Your configured Shiprocket pickup location name
SHIPROCKET_PICKUP_PINCODE=110043
SHIPROCKET_WEBHOOK_TOKEN=replace_with_a_random_webhook_token
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PACKAGE_LENGTH_CM=20
SHIPROCKET_PACKAGE_BREADTH_CM=15
SHIPROCKET_PACKAGE_HEIGHT_CM=10
SHIPROCKET_PACKAGE_WEIGHT_KG=0.5
SHIPROCKET_RETURN_SELLER_NAME=Nayamo
SHIPROCKET_RETURN_SELLER_ADDRESS=Your configured return address
SHIPROCKET_RETURN_SELLER_CITY=New Delhi
SHIPROCKET_RETURN_SELLER_STATE=Delhi
SHIPROCKET_RETURN_SELLER_PINCODE=110043
SHIPROCKET_RETURN_SELLER_COUNTRY=India
SHIPROCKET_RETURN_SELLER_PHONE=9773951349
SHIPROCKET_RETURN_SELLER_EMAIL=support@nayamo.in
